def descriptografar_arquivos(chave: bytes):
    """
    Simula a fase de descriptografia (após pagamento do resgate, em ataques reais).
    Demonstra que SEM a chave correta, é impossível recuperar os dados.
    """
    if not PASTA_CRIPTOGRAFADA.exists():
        print(" Pasta de arquivos criptografados não encontrada.")
        return

    if not Path(ARQUIVO_METADADOS).exists():
        print(" Metadados não encontrados. Execute a criptografia primeiro.")
        return

    try:
        fernet = Fernet(chave)
    except Exception:
        print(" Chave inválida! Em um ataque real, sem a chave correta, os dados são perdidos.")
        return

    with open(ARQUIVO_METADADOS) as f:
        metadados = json.load(f)

    PASTA_TESTE.mkdir(exist_ok=True)
    print("\n Iniciando descriptografia...")

    sucesso = 0
    for nome_criptografado, nome_original in metadados.items():
        caminho_enc = PASTA_CRIPTOGRAFADA / nome_criptografado
        if not caminho_enc.exists():
            print(f"  [!] Arquivo não encontrado: {nome_criptografado}")
            continue

        try:
            dados_enc = caminho_enc.read_bytes()
            dados_originais = fernet.decrypt(dados_enc)

            destino = PASTA_TESTE / nome_original
            destino.write_bytes(dados_originais)

            print(f"  [] {nome_criptografado} → {nome_original}")
            sucesso += 1
        except Exception as e:
            print(f"  [] Falha ao descriptografar {nome_criptografado}: {e}")

    print(f"\n {sucesso}/{len(metadados)} arquivos recuperados em '{PASTA_TESTE}/'")


