            print("\n Demonstração concluída!")

        elif opcao == "0":
            print("\n Encerrando laboratório. Use este conhecimento para DEFENDER sistemas!")
            break

        else:
            print("Opção inválida. Tente novamente.")


if __name__ == "__main__":
