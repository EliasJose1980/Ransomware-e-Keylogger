                print("  Crie os arquivos de teste primeiro (opção 1).")
                continue
            chave = gerar_chave()
            criptografar_arquivos(chave)

        elif opcao == "3":
            if not Path(ARQUIVO_CHAVE).exists():
                print("  Arquivo de chave não encontrado. Execute a criptografia primeiro.")
                continue
            chave = Path(ARQUIVO_CHAVE).read_bytes()
            descriptografar_arquivos(chave)

        elif opcao == "4":
            print("\n Executando demonstração completa...\n")
            criar_arquivos_teste()
            chave = gerar_chave()
